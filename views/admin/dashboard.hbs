

  


    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/styles/dashBoard.css">

<div class="container">
    <div class="header">
        <h1>Admin Dashboard</h1>
        <div class="actions">
            <!-- Logout link corrected to /admin/logout -->
            <a href="/admin/logout" class="btn logout-btn" id="logoutBtn">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </div>
    </div>

    <!-- Search Section -->
    <div class="search-container">
        <i class="fas fa-search"></i>
        <input type="text" id="searchInput" class="search-input" placeholder="Search by email address...">
    </div>

    <!-- Add User Button with new class -->
    <div class="add-container">
        <button class="btn add-user-btn" onclick="addUser()">
            <i class="fas fa-user-plus"></i> Add User
        </button>
    </div>

    <table id="userTable">
        <thead>
            <tr>
                <th>#</th>
                <th>Email Address</th>
                <th>Security</th>
                <th colspan="2" style="text-align: center;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {{#each users}}
            <tr>
                <td>{{inc @index}}</td>
                <td class="user-email"><strong>{{this.email}}</strong></td>
                <td><span class="badge"><i class="fas fa-lock"></i> Hashed</span></td>
                <td>
                    <!-- Edit Button with new class -->
                    <button class="btn edit-btn" onclick="editUser('{{this._id}}')">
                        <i class="fas fa-edit"></i> Edit
                    </button>
                </td>
                <td>
                    <button class="btn delete-btn" onclick="confirmDelete('{{this._id}}')">
                        <i class="fas fa-trash-alt"></i> Delete
                    </button>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>

<script>

if (window.history.replaceState) {
        window.history.replaceState(null, null, window.location.href);
    }


    document.getElementById('searchInput').addEventListener('keyup', function(){

      let filter = this.value.toLowerCase();
      let rows = document.querySelectorAll('#userTable tbody tr');

      rows.forEach( row => {
        let emailCell = row.querySelector( '.user-email');

        if(emailCell){
          let email = emailCell.textContent.toLocaleLowerCase();
          row.style.display = email.includes( filter ) ? "" : 'none'
        }
      })
    })


    // ലോഗൗട്ട് കൺഫർമേഷൻ തിരുത്തിയത്
    document.getElementById('logoutBtn').addEventListener('click', function(e) {
        e.preventDefault();
        Swal.fire({
            title: 'Logout?',
            text: "Are you sure you want to end your session?",
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#4361ee',
            cancelButtonColor: '#aaa',
            confirmButtonText: 'Yes, Logout'
        }).then((result) => {
            if (result.isConfirmed) {
                // ഇവിടെ /admin/logout എന്ന് നൽകണം
                window.location.href = "/admin/logout";
            }
        });
    });

    // ... ബാക്കി നിങ്ങളുടെ സർച്ച്, ഡിലീറ്റ് ഫംഗ്‌ഷനുകൾ മാറ്റമില്ലാതെ തുടരാം

        // 1. Delete User Function
    function confirmDelete(userId) {
        Swal.fire({
            title: 'Are you sure?',
            text: "Do you want to delete this user?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#e11d48',
            cancelButtonColor: '#aaa',
            confirmButtonText: 'Yes, Delete!'
        }).then((result) => {
            if (result.isConfirmed) {
                // ബാക്ക്-എൻഡിലെ ഡിലീറ്റ് റൂട്ടിലേക്ക് ഐഡി അയക്കുന്നു
                window.location.href = "/admin/delete-user/" + userId;
            }
        });
    }

    // 2. Edit User Function
    // (Edit ബട്ടണിൽ നേരിട്ട് ലിങ്ക് നൽകുന്നതാണ് നല്ലത്, എങ്കിലും ഫംഗ്ഷൻ വഴിയാണെങ്കിൽ ഇത് ഉപയോഗിക്കാം)
    function editUser(userId) {
        window.location.href = "/admin/edit-user/" + userId;
    }

    // 3. Add User Function
    function addUser() {
        // പുതിയ യൂസറെ ചേർക്കാനുള്ള പേജിലേക്ക് പോകുന്നു
        window.location.href = "/admin/add-user";
    }

    // 4. Logout Function
    function logoutAdmin() {
        Swal.fire({
            title: 'Logout?',
            text: "സെഷൻ അവസാനിപ്പിക്കണോ?",
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Yes, Logout'
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = "/admin/logout";
            }
        });
    }
</script>






    
 
